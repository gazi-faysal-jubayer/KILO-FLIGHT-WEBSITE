    },
    {
      "page": "/cars",
      "regex": "^/cars(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/cars(?:/)?$"
    },
    {
      "page": "/contact",
      "regex": "^/contact(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/contact(?:/)?$"
    },
    {
      "page": "/join-us",
      "regex": "^/join\\-us(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/join\\-us(?:/)?$"
    },
    {
      "page": "/sponsorship",
