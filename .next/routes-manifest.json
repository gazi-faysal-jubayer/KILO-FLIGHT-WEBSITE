      "routeKeys": {},
      "namedRegex": "^/admin/inquiries(?:/)?$"
    },
    {
      "page": "/admin/login",
      "regex": "^/admin/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/login(?:/)?$"
    },
    {
      "page": "/admin/recruitment",
      "regex": "^/admin/recruitment(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/recruitment(?:/)?$"
    },
    {
      "page": "/admin/settings",
      "regex": "^/admin/settings(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/settings(?:/)?$"
    },
    {
      "page": "/admin/sponsorship",
      "regex": "^/admin/sponsorship(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/sponsorship(?:/)?$"
    },
    {
      "page": "/admin/subteams",
      "regex": "^/admin/subteams(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/subteams(?:/)?$"
    },
    {
      "page": "/admin/team",
      "regex": "^/admin/team(?:/)?$",
      "routeKeys": {},
